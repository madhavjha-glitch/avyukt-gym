rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Shared Helpers ────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthString(val) {
      return val is string && val.size() == 7 && val.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // ─── Validation Helpers ────────────────────────────────────
    function isValidMember(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.phone is string &&
             data.phone.size() >= 7 &&
             data.phone.size() <= 20 &&
             isValidDateString(data.joinDate) &&
             (!('batch' in data) || (data.batch is string && data.batch in ['MORNING', 'EVENING', 'BOTH'])) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidAttendanceDay(data, userId, dateId) {
      return data.userId is string &&
             data.userId == userId &&
             isValidDateString(data.date) &&
             data.date == dateId &&
             data.records is map &&
             data.records.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidFeeMonth(data, userId, monthId) {
      return data.userId is string &&
             data.userId == userId &&
             isValidMonthString(data.month) &&
             data.month == monthId &&
             data.records is map &&
             data.records.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // ─── Members Collection ────────────────────────────────────
    match /users/{userId}/members/{memberId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(memberId);

      allow create: if isOwner(userId) &&
                       isValidId(memberId) &&
                       incoming().keys().hasAll(['userId', 'name', 'phone', 'joinDate', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'phone', 'joinDate', 'batch', 'createdAt', 'updatedAt']) &&
                       isValidMember(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(memberId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidMember(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'joinDate', 'batch', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(memberId);
    }

    // ─── Attendance Collection ─────────────────────────────────
    match /users/{userId}/attendance/{dateId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidDateString(dateId);

      allow create: if isOwner(userId) &&
                       isValidDateString(dateId) &&
                       incoming().keys().hasAll(['userId', 'date', 'records', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'date', 'records', 'createdAt', 'updatedAt']) &&
                       isValidAttendanceDay(incoming(), userId, dateId);

      allow update: if isOwner(userId) &&
                       isValidDateString(dateId) &&
                       incoming().userId == existing().userId &&
                       incoming().date == existing().date &&
                       incoming().createdAt == existing().createdAt &&
                       isValidAttendanceDay(incoming(), userId, dateId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['records', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidDateString(dateId);
    }

    // ─── Fees Collection ───────────────────────────────────────
    match /users/{userId}/fees/{monthId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidMonthString(monthId);

      allow create: if isOwner(userId) &&
                       isValidMonthString(monthId) &&
                       incoming().keys().hasAll(['userId', 'month', 'records', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'month', 'records', 'createdAt', 'updatedAt']) &&
                       isValidFeeMonth(incoming(), userId, monthId);

      allow update: if isOwner(userId) &&
                       isValidMonthString(monthId) &&
                       incoming().userId == existing().userId &&
                       incoming().month == existing().month &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFeeMonth(incoming(), userId, monthId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['records', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidMonthString(monthId);
    }
  }
}
